        document_number: xsd:string
        administrative_number: xsd:string
        driving_privileges: rdf:JSON
        un_distinguishing_sign: xsd:string
        sex: xsd:unsignedInt
        height: xsd:unsignedInt
        weight: xsd:unsignedInt
        eye_colour: xsd:string
        hair_colour: xsd:string
        birth_place: xsd:string
        nationality: xsd:string
        resident_address: xsd:string
        resident_city: xsd:string
        resident_state: xsd:string
        resident_postal_code: xsd:string
        resident_country: xsd:string
        family_name_national_character: xsd:string
        given_name_national_character: xsd:string
        portrait: URL
        portrait_capture_date: xsd:dateTime
        signature_usual_mark: URL
        age_in_years: xsd:unsignedInt
        age_birth_year: xsd:unsignedInt
        age_over_18: xsd:boolean
        age_over_21: xsd:boolean
        age_over_25: xsd:boolean
        age_over_62: xsd:boolean
        age_over_65: xsd:boolean
